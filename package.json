{
  "name": "storyly",
  "version": "1.0.0",
  "description": "Storyly Platform - Instagram-style stories for Android",
  "scripts": {
    "install:backend": "cd backend && npm install",
    "install:dashboard": "cd dashboard && npm install",
    "build:backend": "cd backend && npm run build",
    "build:dashboard": "cd dashboard && npm run build",
    "start:backend": "cd backend && npm start",
    "start:dashboard": "node dashboard-server.js",
    "install": "npm run install:backend",
    "build": "npm run build:backend",
    "start": "npm run start:backend",
    "deploy:dashboard": "npm run install:dashboard && npm run build:dashboard && npm run start:dashboard"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/naveenmamgain14/storyly.git"
  },
  "keywords": ["storyly", "stories", "sdk", "android"],
  "author": "Naveen Mamgain",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
